# ──────────────────────────────────────────────
#  Trustify — Environment Variables
#  Copy this file to .env and fill in values
# ──────────────────────────────────────────────

# Google Gemini API Key (required for AI remediation)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB connection string (default works with docker-compose)
MONGO_URI=mongodb://localhost:27017/trustify

# Workspace directory for cloned repos / extracted ZIPs
WORKSPACE_DIR=/tmp/trustify_workspaces

# Backend environment
ENVIRONMENT=development

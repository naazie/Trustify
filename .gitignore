# ─── Environment & Secrets ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ─── Python / Backend ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.so
.venv/
venv/
env/

# ─── Node / Frontend ────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ─── Docker & Compose ───────────────────────────────────────────────────────
# Don't ignore docker-compose.yml itself — it's source-controlled
# But ignore override files that contain local-machine settings:
docker-compose.override.yml

# ─── Scan Workspaces (runtime-generated, can be large) ──────────────────────
/tmp/trustify_workspaces/

# ─── Debug Artifacts (generated by tool runners) ────────────────────────────
backend/tools/_debug_*
*/_debug_*.json
*/_debug_*.txt

# ─── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/

# ─── OS / Editor Junk ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.kiro
